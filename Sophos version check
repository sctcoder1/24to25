powershell.exe -NoLogo -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop';$base=$null;$cv=$null;try{$base=[Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine,[Microsoft.Win32.RegistryView]::Registry64);$cv=$base.OpenSubKey('SOFTWARE\Microsoft\Windows NT\CurrentVersion');if(-not $cv){throw 'Windows version registry key unavailable'};$v=[string]$cv.GetValue('DisplayVersion');$b=[int]$cv.GetValue('CurrentBuildNumber');$u=[int]$cv.GetValue('UBR');$client=$cv.GetValue('InstallationType') -eq 'Client';$os=Get-CimInstance Win32_OperatingSystem -OperationTimeoutSec 15;$running=[int]$os.BuildNumber;$w='Other or inconsistent release - review';$p='Not applicable';if($client -and $v -eq '24H2' -and $b -eq 26100){$w='Windows 11 24H2';$p=if($u -ge 5074){'YES - KB5064081 or later CU level met'}else{'NO - install a current non-preview 24H2 CU'}};if($client -and $v -eq '25H2' -and $b -eq 26200){$w=if($running -eq 26200){'Windows 11 25H2'}else{'25H2 staged/reported - verify after reboot'};$p='Not needed if 25H2 is confirmed after reboot'};$pending=@();foreach($key in @('SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending','SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired')){$k=$base.OpenSubKey($key);if($k){$pending+=$key;$k.Dispose()}};[pscustomobject]@{Computer=$env:COMPUTERNAME;Windows=$w;DisplayVersion=$v;Edition=$cv.GetValue('EditionID');InstalledBuild=('{0}.{1}' -f $b,$u);RunningBuild=$running;Minimum24H2Build='26100.5074';PrerequisiteCU=$p;UpdateRestartPending=if($pending.Count){'YES - restart and recheck'}else{'No CBS/WU registry flag found (not exhaustive)'}}|Format-List|Out-String -Width 220|Write-Output;Write-Output 'Read-only. Build eligibility does not prove package applicability, compatibility or an update offer.'}catch{Write-Output ('CHECK FAILED: '+$_.Exception.Message);exit 1}finally{if($cv){$cv.Dispose()};if($base){$base.Dispose()}}"

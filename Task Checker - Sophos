powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Continue';Write-Output '=== MATCHING UPGRADE TASKS ===';$tasks=Get-ScheduledTask -ErrorAction SilentlyContinue|Where-Object {$_.TaskName -like 'Win11-23H2-to-25H2-*' -or $_.TaskName -like 'Win11-25H2-*'};if($tasks){foreach($t in $tasks){Write-Output ('--- '+$t.TaskName+' ---');Write-Output ('State: '+$t.State);foreach($a in @($t.Actions)){Write-Output ('Execute: '+$a.Execute);Write-Output ('Arguments: '+$a.Arguments)};$i=$t|Get-ScheduledTaskInfo;Write-Output ('LastRunTime: '+$i.LastRunTime);Write-Output ('LastTaskResult: '+$i.LastTaskResult);Write-Output ('NextRunTime: '+$i.NextRunTime);Write-Output ''}}else{Write-Output 'No matching Win11 upgrade tasks found.'};Write-Output '=== ALL CURRENTLY RUNNING SCHEDULED TASKS ===';$running=Get-ScheduledTask -ErrorAction SilentlyContinue|Where-Object {$_.State -eq 'Running'};if($running){$running|Select-Object TaskPath,TaskName,State|Format-Table -AutoSize}else{Write-Output 'No scheduled tasks currently report Running.'};Write-Output '=== ACTIVE UPDATE / SERVICING PROCESSES ===';$p=Get-Process -ErrorAction SilentlyContinue|Where-Object {$_.ProcessName -match 'SetupHost|SetupPrep|setup|dism|wusa|TiWorker|TrustedInstaller|MoUsoCoreWorker|UsoClient'}|Select-Object ProcessName,Id,CPU,StartTime;if($p){$p|Format-Table -AutoSize}else{Write-Output 'No common Windows servicing processes active.'};Write-Output '=== REBOOT STATUS ===';$pending=@();foreach($k in @('HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending','HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired')){if(Test-Path $k){$pending+=$k}};try{$si=New-Object -ComObject Microsoft.Update.SystemInfo;if($si.RebootRequired){$pending+='Microsoft.Update.SystemInfo'}}catch{};if($pending.Count){Write-Output 'REBOOT PENDING: YES';$pending}else{Write-Output 'No obvious reboot-pending flag found.'};Write-Output '=== UPGRADE STATE FILES ===';foreach($f in @('C:\ProgramData\Win11-23H2-to-25H2\state.json','C:\ProgramData\Win11-25H2\direct-state.json')){if(Test-Path -LiteralPath $f){Write-Output ('--- '+$f+' ---');Get-Content -LiteralPath $f}else{Write-Output ('Missing: '+$f)}}"

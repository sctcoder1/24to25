powershell.exe -NoLogo -NoProfile -NonInteractive -Command "$u=[string](Get-CimInstance Win32_ComputerSystem).UserName;Write-Output ('Computer: '+$env:COMPUTERNAME);if([string]::IsNullOrWhiteSpace($u)){Write-Output 'ACTIVE USER: None detected';Write-Output 'SESSIONS:';quser 2>$null;exit 0};Write-Output ('ACTIVE USER: '+$u);Write-Output 'SESSIONS:';quser 2>$null;Write-Output '';Write-Output ('PROCESSES OWNED BY '+$u+':');$p=@(Get-Process -IncludeUserName -ErrorAction SilentlyContinue|Where-Object {$_.UserName -ieq $u}|Sort-Object ProcessName);if($p.Count){$p|Select-Object ProcessName,Id,@{Name='MemoryMB';Expression={[math]::Round($_.WorkingSet64/1MB,1)}},MainWindowTitle|Format-Table -AutoSize|Out-String -Width 240|Write-Output}else{Write-Output 'No accessible processes found for the active user.'}"
